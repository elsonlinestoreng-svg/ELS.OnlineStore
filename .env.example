# ---------------------------------------------------------------------------
# ELS Online Store — environment template
#
# Copy to `.env` and fill in the values marked REQUIRED. `.env` is gitignored;
# this file is the tracked, secret-free reference.
#
#   cp .env.example .env
#
# The app reads this file itself (backend/server/config/env.js resolves it
# relative to the repository, not the working directory), so the server finds it
# no matter where you start it from.
#
# Two rules the code enforces, so you are not surprised by a refusal to boot:
#
#   1. In production (NODE_ENV=production) there are NO secret defaults. A
#      missing or short secret aborts startup rather than shipping a forgeable
#      token or an open shop.
#   2. Verification and captcha fail closed. If you enable a gate without the
#      credentials it needs, production will not start. In development the same
#      situation is downgraded to a warning plus a safe local fallback.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8001

# --- Core secrets (REQUIRED) ------------------------------------------------

# MongoDB connection string. Treat as a secret: it usually embeds credentials.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Signing key for session tokens. Must be at least 32 characters in production;
# generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=1d

# Paystack. The secret key must never reach the browser.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Email verification (REQUIRED for a real shop) ---------------------------
#
# Registration issues a 6-digit code that the customer must enter before they can
# hold a session. This is on by default and cannot be meaningfully off: an
# account that is never verified can never sign in.
#
# Without SMTP configured, DEVELOPMENT prints the code to the server console and
# returns it in the API response as `dev_code` so you can test the flow. That
# fallback is disabled in production, which instead refuses to start — nobody
# could ever verify, so the shop would be permanently locked.
#
# A relay that ACCEPTS THE CONNECTION but REJECTS THESE CREDENTIALS is a
# different failure, and the server cannot tell the two apart by reading this
# file: a non-empty SMTP_PASS looks identical to a working one. So on startup it
# authenticates against the relay and reports the resolved state, and in
# production a rejected credential aborts the boot. Watch the first lines of the
# server output for:
#
#     [config] SMTP relay: REACHABLE (host:port, from <sender>)
#
# Anything other than REACHABLE means no verification email will be sent, every
# new account will be stuck unverified, and no customer will be able to sign in.
# SMTP_PASS must be the SMTP key your provider issued, not the password you signed
# up with.

# Leave unset in development. In production, set all of these or set
# EMAIL_VERIFICATION_REQUIRED=false.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-verified-address@example.com
SMTP_PASS=the-smtp-key-your-provider-issued
FROM_EMAIL=your-verified-address@example.com

# Set to false to skip verification entirely. Only sensible for local work.
EMAIL_VERIFICATION_REQUIRED=true

# How long a code stays valid, and how many wrong attempts before the code is
# burned and a new one must be requested.
EMAIL_VERIFICATION_TTL_MINUTES=15
MAX_VERIFICATION_ATTEMPTS=5

# --- Google reCAPTCHA --------------------------------------------------------
#
# Guards registration, sign-in and payment. Add both keys and the widgets appear
# on those three screens; leave them out and the app behaves exactly as before.
#
# RECAPTCHA_ENABLED is a three-way switch:
#   unset    -> on if both keys are present, off otherwise (recommended)
#   true     -> must have both keys; production refuses to boot without them
#   false    -> forced off
#
# Do NOT set true while the keys are missing. In development that silently
# disables the captcha for the process; in production it will not start.

# Use a v2 "Checkbox" key, not v3: frontend/js/recaptcha.js renders the widget
# with size:'normal', and a v3 key requires size:'invisible'. With a v3 key the
# widget never loads and register / sign-in / payment all fail.
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
# RECAPTCHA_ENABLED=true

# --- Super admin ------------------------------------------------------------
#
# The dashboard (frontend/admin.html) is served entirely from this one role.
# There is no separate `admin` role.
#
# SUPER_ADMIN_EMAIL must match an account that already exists. On boot, that
# account is promoted to super_admin if it is not already, so the first person to
# set this value gets in. Leave it unset and, if no account already holds the
# role, nobody can open the dashboard — the server warns about this at startup.
#
# To claim the role for an existing account, either set this and restart, or
# have any current super admin promote them from the dashboard's Users view.
SUPER_ADMIN_EMAIL=you@example.com

# --- Deployment --------------------------------------------------------------

# Where the storefront is served from. Used for links in emails.
APP_ORIGIN=http://localhost:8081

# Extra origins allowed to call the API, comma separated. Unset means
# same-origin only. Needed when the storefront and API are on different hosts.
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# Set only when running behind a reverse proxy (nginx, Heroku, Cloudflare).
# Without this, req.ip is the proxy's address and per-IP rate limiting groups
# every customer into one bucket. Use the number of proxy hops, or `true` if you
# fully control the header.
# TRUST_PROXY=1

# Per-IP budget shared by login, register, verify and reset. Deliberately
# shared so an attacker cannot multiply attempts by cycling endpoints, but that
# also means every customer behind one carrier-grade NAT draws from the same
# budget. Raise it if genuine users are being locked out.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
